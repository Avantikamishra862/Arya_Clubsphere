# ==============================================================================
# Arya College ClubSphere - Environment Configuration Template
# Copy to .env for local Docker / hosting platforms, or export these variables
# in your shell / Tomcat setenv.sh. NEVER commit real credentials.
#
# DBUtil reads environment variables first, then application.properties.
# ==============================================================================

# HTTP port used by Tomcat inside Docker (Render also injects PORT)
PORT=8080

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# Local MySQL (default names used by database/schema.sql)
DB_URL=jdbc:mysql://localhost:3306/clubsphere_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# Hosted MySQL example (Aiven, PlanetScale, Render, etc.)
# DB_URL=jdbc:mysql://YOUR_HOST:3306/clubsphere_db?sslMode=REQUIRED&serverTimezone=UTC
# DB_USERNAME=YOUR_DATABASE_USERNAME
# DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Aliases also accepted by DBUtil:
# DATABASE_URL, DB_USER, MYSQLUSER, MYSQLPASSWORD

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
# Public origin used to build QR registration links.
# Local WAR on Tomcat with default Maven finalName:
APP_BASE_URL=http://localhost:8080/aryaClgClubSphere

# Docker Compose / ROOT.war (context path is /):
# APP_BASE_URL=http://localhost:8080

# Live Render example:
# APP_BASE_URL=https://event-management-uylc.onrender.com

# Optional upload directory (relative to the working directory)
APP_UPLOAD_DIR=uploads
